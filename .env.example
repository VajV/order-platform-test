# =============================================================================
# Order Processing Platform - Environment Variables Template
# =============================================================================
# Р’РќРРњРђРќРР•: Р­С‚Рѕ С€Р°Р±Р»РѕРЅ! РЎРѕР·РґР°Р№С‚Рµ С„Р°Р№Р» .env Рё Р·Р°РїРѕР»РЅРёС‚Рµ СЂРµР°Р»СЊРЅС‹РјРё Р·РЅР°С‡РµРЅРёСЏРјРё.
# РќР• РєРѕРјРјРёС‚СЊС‚Рµ .env С„Р°Р№Р» РІ Git!
# =============================================================================

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_strong_password_123
POSTGRES_DB=postgres

# Database names for each microservice
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
PRODUCT_DB_NAME=product_db
ORDER_DB_NAME=order_db
INVENTORY_DB_NAME=inventory_db

# =============================================================================
# MongoDB Configuration
# =============================================================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION_mongo_secure_pass_456
MONGO_INITDB_DATABASE=notifications

# =============================================================================
# JWT Configuration
# =============================================================================
# РљР РРўРР§Р•РЎРљР Р’РђР–РќРћ: РСЃРїРѕР»СЊР·СѓР№С‚Рµ РЅР°РґС‘Р¶РЅС‹Р№ СЃРµРєСЂРµС‚ РґР»РёРЅРѕР№ РјРёРЅРёРјСѓРј 32 СЃРёРјРІРѕР»Р°!
# Р“РµРЅРµСЂР°С†РёСЏ: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET_WITH_OPENSSL_MINIMUM_32_CHARS_REQUIRED

# JWT Token Expiration (milliseconds)
JWT_EXPIRATION=3600000  # 1 hour
JWT_REFRESH_EXPIRATION=604800000  # 7 days

# =============================================================================
# HashiCorp Vault Configuration (Optional)
# =============================================================================
VAULT_URI=http://vault:8200
VAULT_TOKEN=dev-root-token-CHANGE_IN_PROD

# Production: РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ AppRole РёР»Рё Kubernetes auth
# VAULT_ROLE_ID=your-role-id
# VAULT_SECRET_ID=your-secret-id

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=  # РћСЃС‚Р°РІСЊС‚Рµ РїСѓСЃС‚С‹Рј РґР»СЏ dev, СѓСЃС‚Р°РЅРѕРІРёС‚Рµ РІ prod

# =============================================================================
# Email Configuration (for notification-service)
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD_OR_SMTP_TOKEN

# =============================================================================
# Spring Profiles
# =============================================================================
SPRING_PROFILES_ACTIVE=docker  # Options: dev, docker, prod

# =============================================================================
# Logging Level
# =============================================================================
LOG_LEVEL=INFO  # Options: TRACE, DEBUG, INFO, WARN, ERROR

# =============================================================================
# CORS Configuration (for api-gateway)
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200  # Frontend URLs

# =============================================================================
# Rate Limiting (for api-gateway)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# =============================================================================
# Kafka Configuration (Advanced)
# =============================================================================
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_REPLICATION_FACTOR=1  # Set to 3+ in production cluster

# =============================================================================
# Monitoring (Future)
# =============================================================================
# GRAFANA_ADMIN_PASSWORD=admin
# PROMETHEUS_RETENTION=30d
