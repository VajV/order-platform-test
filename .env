# ========================================
# INFRASTRUCTURE CREDENTIALS
# ========================================

# PostgreSQL (общая БД для user, product, order, inventory)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=ecommerce

AUTH_DB_NAME=auth_db
PRODUCT_DB_NAME=product_db
ORDER_DB_NAME=order_db
USER_DB_NAME=user_db
INVENTORY_DB_NAME=inventory_db

# MongoDB (для notification-service)
MONGO_INITDB_DATABASE=notifications
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=mongo123

# Redis (кэширование, rate-limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8082

# JWT (для микросервисов)
JWT_SECRET=MySecretJwtKey256BitsLongForHS256AlgorithmChangeThisInProduction12345678901234567890
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Spring Profiles
SPRING_PROFILES_ACTIVE=docker

# Vault
VAULT_URI=http://vault:8200
VAULT_TOKEN=dev-token-12345
