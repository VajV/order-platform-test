# ========================================
# INFRASTRUCTURE CREDENTIALS
# ========================================

# PostgreSQL (общая БД для user, product, order, inventory)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=postgres123

# MongoDB (для notification-service)
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=notifications
MONGODB_USERNAME=admin
MONGODB_PASSWORD=mongo123

# Redis (кэширование, rate-limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8082

# JWT (для микросервисов)
JWT_SECRET=MySecretJwtKey256BitsLongForHS256AlgorithmChangeThisInProduction12345678901234567890
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Spring Profiles
SPRING_PROFILES_ACTIVE=docker
